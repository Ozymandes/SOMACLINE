__pycache__/
*.pyc
.venv/
qa-out/

# Hardware generation archive: 2K masters + rejected candidates, ~171MB.
# Kept on disk (they are the source for tools/build_sprites.py) but out of git.
# The runtime sprites in assets/sprites/ ARE committed - the app needs them.
assets/hardware_v2/*/
!assets/hardware_v2/INVENTORY.md

# Rejected / superseded module generations: kept on disk, out of git.
assets/modules/rejected/
rust/target/

# Cargo build output. `rust/target/` was ignored; the framework-floor probe's
# own target/ was not, and 720.8 MB of compiled rlibs across 1338 files had
# been committed. Untracked in the release audit; the probe SOURCE stays.
rust/floor/target/

# Optional display typefaces. NOT redistributed: Astro and Microgramma are
# third-party faces the project does not have redistribution rights to, so
# they are never committed and never installed. Drop them in here yourself and
# the app will register them for its own process; without them it falls back.
# See README "Optional typography".
assets/fonts/*.ttf
assets/fonts/*.otf
